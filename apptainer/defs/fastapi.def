Bootstrap: docker
From: python:3.11-slim

%files
    requirements.txt /app/requirements.txt
    api /app/api
    utils /app/utils

%post
    apt-get update && apt-get install -y \
        curl \
        gcc \
        default-libmysqlclient-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

    mkdir -p /app/logs
    cd /app
    pip install --no-cache-dir -r /app/requirements.txt

%environment
    export PYTHONPATH=/app
    export PYTHONUNBUFFERED=1

%runscript
    cd /app
    if [ "${FASTAPI_RELOAD:-1}" = "1" ]; then
        exec uvicorn api.main:app --host 0.0.0.0 --port "${FASTAPI_PORT:-8090}" --reload
    fi

    exec uvicorn api.main:app --host 0.0.0.0 --port "${FASTAPI_PORT:-8090}"
